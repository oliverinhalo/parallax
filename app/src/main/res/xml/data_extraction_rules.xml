<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer rules.

  Everything is excluded. A project is tens to hundreds of megabytes of frames,
  checkpoints and meshes, and cloud backup would copy data the user was promised
  stays on the device. `.parallax` bundle export is the supported way to move a
  scan, and it is explicit.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
