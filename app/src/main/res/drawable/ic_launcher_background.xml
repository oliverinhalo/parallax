<?xml version="1.0" encoding="utf-8"?>
<!--
  The icon's background: the graphite field the whole app sits on, with a faint
  cyan glow rising from the lower left so the foreground motif reads as lit
  rather than pasted on. Drawn at the adaptive-icon canvas size of 108dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#0E1013" />

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor" xmlns:aapt="http://schemas.android.com/aapt">
            <gradient
                android:type="radial"
                android:centerX="34"
                android:centerY="78"
                android:gradientRadius="74"
                android:startColor="#333DE0FF"
                android:endColor="#000E1013" />
        </aapt:attr>
    </path>
</vector>
