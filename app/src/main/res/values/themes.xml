<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The activity theme exists only for the window and the splash screen; every
      pixel inside is drawn by Compose. The splash background matches the
      app's darkest surface so there is no flash between the two.
    -->
    <style name="Theme.Parallax" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface_sunken</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Parallax.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/surface_sunken</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Parallax</item>
    </style>
</resources>
