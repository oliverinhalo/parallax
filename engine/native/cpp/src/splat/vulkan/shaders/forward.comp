#version 450
#extension GL_GOOGLE_include_directive : require

// Front-to-back alpha compositing, one workgroup per 16x16 tile.
//
// The tile's splats are pulled into shared memory in batches of 256 so that
// each of them is read from global memory once per tile rather than once per
// pixel, which is the difference between this being bandwidth-bound and being
// usable. Mirrors rasterizeSplats() in src/splat/SplatRaster.cpp.

#include "common.glsl"
#include "params.glsl"

layout(local_size_x = TILE_SIZE, local_size_y = TILE_SIZE) in;

layout(set = 0, binding = 1, std430) readonly buffer Projected { float proj[]; };
layout(set = 0, binding = 2, std430) readonly buffer Ranges { uint tile_range[]; };
layout(set = 0, binding = 3, std430) readonly buffer Values { uint pair_value[]; };
layout(set = 0, binding = 4, std430) writeonly buffer Rendered { float rendered[]; };
layout(set = 0, binding = 5, std430) writeonly buffer Transmittance { float transmittance[]; };
layout(set = 0, binding = 6, std430) writeonly buffer Contributors { uint contributors[]; };

shared uint batch_index[256];
shared vec2 batch_mean[256];
shared vec4 batch_conic_opacity[256];
shared vec3 batch_color[256];
shared uint finished_count;

void main() {
  uint tile = gl_WorkGroupID.y * uint(TILE_COLS) + gl_WorkGroupID.x;
  uint thread = gl_LocalInvocationIndex;

  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  bool inside = pixel.x < VIEW_WIDTH && pixel.y < VIEW_HEIGHT;
  vec2 point = vec2(float(pixel.x) + 0.5, float(pixel.y) + 0.5);

  uint begin = tile_range[tile * 2u];
  uint end = tile_range[tile * 2u + 1u];
  uint total = end > begin ? end - begin : 0u;
  uint rounds = (total + 255u) / 256u;

  float remaining = 1.0;
  vec3 accumulated = vec3(0.0);
  uint last_contributor = 0u;
  bool done = !inside;

  if (thread == 0u) finished_count = 0u;
  barrier();
  if (done) atomicAdd(finished_count, 1u);

  for (uint round = 0u; round < rounds; ++round) {
    barrier();
    // Once every pixel in the tile has saturated there is nothing left to
    // composite, and the remaining batches can be skipped entirely.
    if (finished_count == 256u) break;

    uint fetch = begin + round * 256u + thread;
    if (fetch < end) {
      uint splat = pair_value[fetch];
      uint base = splat * PROJ_STRIDE;
      batch_index[thread] = splat;
      batch_mean[thread] = vec2(proj[base + PROJ_MEAN_X], proj[base + PROJ_MEAN_Y]);
      batch_conic_opacity[thread] = vec4(proj[base + PROJ_CONIC_X], proj[base + PROJ_CONIC_Y],
                                         proj[base + PROJ_CONIC_Z], proj[base + PROJ_OPACITY]);
      batch_color[thread] = vec3(proj[base + PROJ_COLOR_R], proj[base + PROJ_COLOR_G],
                                 proj[base + PROJ_COLOR_B]);
    }
    barrier();
    if (done) continue;

    uint available = min(256u, total - round * 256u);
    for (uint j = 0u; j < available; ++j) {
      vec2 d = point - batch_mean[j];
      vec4 conic_opacity = batch_conic_opacity[j];
      float power = -0.5 * (conic_opacity.x * d.x * d.x + conic_opacity.z * d.y * d.y) -
                    conic_opacity.y * d.x * d.y;
      if (power > 0.0) continue;
      float alpha = min(float(MAX_ALPHA), conic_opacity.w * exp(power));
      if (alpha < MIN_ALPHA) continue;

      accumulated += remaining * alpha * batch_color[j];
      remaining *= 1.0 - alpha;
      last_contributor = round * 256u + j + 1u;
      if (remaining < TRANSMITTANCE_CUTOFF) {
        done = true;
        atomicAdd(finished_count, 1u);
        break;
      }
    }
  }

  if (!inside) return;
  uint offset = uint(pixel.y) * uint(VIEW_WIDTH) + uint(pixel.x);
  vec3 color = accumulated + remaining * params.background.rgb;
  rendered[offset * 3u + 0u] = color.r;
  rendered[offset * 3u + 1u] = color.g;
  rendered[offset * 3u + 2u] = color.b;
  transmittance[offset] = remaining;
  contributors[offset] = last_contributor;
}
