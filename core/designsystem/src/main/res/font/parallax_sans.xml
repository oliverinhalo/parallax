<?xml version="1.0" encoding="utf-8"?>
<!--
  Inter as a single variable font.

  One variable file covers every weight we use, which is smaller than shipping
  four static cuts and lets the type scale reach intermediate weights. Each
  entry pins the `wght` axis; `ttcIndex` is unused for a non-collection file.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/inter_variable"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400" />
    <font
        android:font="@font/inter_variable"
        android:fontStyle="normal"
        android:fontWeight="500"
        android:fontVariationSettings="'wght' 500" />
    <font
        android:font="@font/inter_variable"
        android:fontStyle="normal"
        android:fontWeight="600"
        android:fontVariationSettings="'wght' 600" />
    <font
        android:font="@font/inter_variable"
        android:fontStyle="normal"
        android:fontWeight="700"
        android:fontVariationSettings="'wght' 700" />
</font-family>
